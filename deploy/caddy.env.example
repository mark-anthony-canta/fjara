# Copy to deploy/caddy.env on the server (git-ignored) and fill in.
# Domain pointing at the server's static IP, e.g. from duckdns.org:
SITE_ADDRESS=fjara-dev.duckdns.org
# Username co-developers type at the password prompt:
BASIC_AUTH_USER=fjara
# bcrypt hash of the shared password. Generate it on the server with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# Keep the SINGLE quotes: the hash contains $ signs.
BASIC_AUTH_HASH='$2a$14$replace-with-generated-hash'
